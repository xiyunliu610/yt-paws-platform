DATABASE_URL="postgresql://user@localhost:5432/ytpaws"
JWT_SECRET=
PORT=3000
NODE_ENV=development

# Stripe test-mode keys (dashboard.stripe.com > Developers > API keys).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public HTTPS origin hosting reset/legal pages (no trailing slash).
PUBLIC_WEB_URL=
SUPPORT_EMAIL=
CORS_ORIGINS=

# Transactional password-reset email (Resend).
RESEND_API_KEY=
MAIL_FROM=
# Test/development only. main.ts refuses to start production when true.
EXPOSE_PASSWORD_RESET_TOKEN=false

# S3-compatible object storage (AWS S3 or Cloudflare R2).
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_PUBLIC_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Production operational alert receiver (for example a Slack/Teams workflow
# or an incident platform webhook). Receives no customer email or media.
ALERT_WEBHOOK_URL=
