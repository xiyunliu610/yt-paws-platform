generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  staff
  owner
  admin
}

enum BookingStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

enum PaymentMethod {
  stripe
  wechat_qr
}

enum PricingUnit {
  flat
  per_day
}

enum PaymentStatus {
  pending
  pending_verification
  paid
  failed
  refunded
}

/// A pet care business onboarded to the platform. Version 1 has exactly one
/// row (Y&T Paws); business_id is carried on core tables from Version 1
/// onward so future businesses can be added without a schema migration.
/// See docs/01_Project_Overview.md §11 and docs/03_System_Architecture.md §4.
model Business {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  region    String?
  // Static image of the business's personal WeChat QR code, shown to
  // customers during WeChat payment (US-04.2). There's no official merchant
  // API integration in V1, so this is just a URL the owner sets, not
  // something the platform generates.
  wechatQrCodeUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  staff     User[]
  services  Service[]
  bookings  Booking[]
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  businessId       String?   @db.Uuid
  business         Business? @relation(fields: [businessId], references: [id])
  email            String    @unique
  password         String
  name             String?
  phone            String?
  role             Role      @default(customer)
  // Expo push token, registered client-side after the user grants
  // notification permission. Null until then, or if they never grant it
  // (or are running in an environment where remote push isn't available,
  // e.g. Expo Go on SDK 53+) — in-app notifications work regardless.
  pushToken        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  pets             Pet[]
  bookings         Booking[] @relation("CustomerBookings")
  assignedBookings Booking[] @relation("StaffAssignedBookings")
  notifications    Notification[]
}

model Pet {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  species       String?
  breed         String?
  age           Int?
  weight        Float?
  personality   String?
  dietNotes     String?
  isNeutered    Boolean?
  // Same interim approach as DailyReport.mediaUrls (see
  // docs/03_System_Architecture.md §5.3): a data: URI until real cloud
  // storage exists, not a hosted URL.
  photoUrl      String?
  ownerId       String            @db.Uuid
  owner         User              @relation(fields: [ownerId], references: [id])
  healthRecords PetHealthRecord[]
  bookings      Booking[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model PetHealthRecord {
  id        String    @id @default(uuid()) @db.Uuid
  petId     String    @db.Uuid
  pet       Pet       @relation(fields: [petId], references: [id])
  type      String // "vaccination" or "deworming"
  date      DateTime
  nextDate  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
}

model Service {
  id              String    @id @default(uuid()) @db.Uuid
  businessId      String    @db.Uuid
  business        Business  @relation(fields: [businessId], references: [id])
  name            String
  description     String?
  price           Float
  // Whether `price` is charged once per booking (e.g. grooming) or per
  // calendar day of the booking's date range (e.g. boarding). Booking itself
  // has no stored total; this only drives the estimate shown to the customer
  // until the payments module computes a real charge.
  pricingUnit     PricingUnit @default(flat)
  durationMinutes Int?
  isActive        Boolean   @default(true)
  bookings        Booking[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  businessId      String        @db.Uuid
  business        Business      @relation(fields: [businessId], references: [id])
  customerId      String        @db.Uuid
  customer        User          @relation("CustomerBookings", fields: [customerId], references: [id])
  // Nullable: a booking starts unassigned; the business owner assigns it to
  // a staff member (role = staff, same businessId) after it comes in.
  assignedStaffId String?       @db.Uuid
  assignedStaff   User?         @relation("StaffAssignedBookings", fields: [assignedStaffId], references: [id])
  petId           String        @db.Uuid
  pet             Pet           @relation(fields: [petId], references: [id])
  serviceId       String        @db.Uuid
  service         Service       @relation(fields: [serviceId], references: [id])
  status          BookingStatus @default(pending)
  startDate       DateTime
  endDate         DateTime
  payments        Payment[]
  dailyReports    DailyReport[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Payment {
  id            String        @id @default(uuid()) @db.Uuid
  bookingId     String        @db.Uuid
  booking       Booking       @relation(fields: [bookingId], references: [id])
  method        PaymentMethod
  amount        Float
  status        PaymentStatus @default(pending)
  referenceNote String?
  // Provider-side identifier used to correlate an async callback back to
  // this row (e.g. the Stripe PaymentIntent id). Null for wechat_qr, which
  // has no callback and is reconciled manually instead.
  providerRef   String?
  verifiedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model DailyReport {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @db.Uuid
  booking   Booking  @relation(fields: [bookingId], references: [id])
  text      String?
  mediaUrls String[]
  createdAt DateTime @default(now())
}

/// Version 1's simplified Notification Center (see
/// docs/03_System_Architecture.md §7): no dedicated REST module beyond this
/// read/mark-read surface — rows are created as a side effect from within
/// bookings/payments (US-05.1/US-05.2), not via a public "create" endpoint.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}
